node_modules/
dist/
**/dist/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Spike apps — exploratory throwaway code; reports are tracked in docs/
spikes/

# Rust build artifacts
target/
**/target/
Cargo.lock.bak

# Tauri build outputs
src-tauri/target/
src-tauri/gen/

# Mobile icon variants produced by `pnpm tauri icon`. The desktop bundle
# doesn't ship Android/iOS targets; these get regenerated on demand if a
# future story adds mobile bundling. (Story 1.17.)
apps/*/src-tauri/icons/android/
apps/*/src-tauri/icons/ios/

# Pre-built sidecar binaries (e.g. the persona-supervisor). Build artifacts
# regenerated on demand; never committed. (Story 1.17 sidecar work.)
apps/*/src-tauri/binaries/

# TypeScript incremental build cache
*.tsbuildinfo
**/tsconfig.tsbuildinfo

# ─── Build / test / coverage outputs (explicit) ────────────────────
# Generic build output, in case a future tool uses a non-`dist/` name
build/
**/build/

# Vitest / Jest / coverage reporters
coverage/
**/coverage/
*.lcov

# ─── Environment & secrets ──────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ─── VitePress ──────────────────────────────────────────────────────
# VitePress cache + temp dirs (apps/docs/.vitepress/)
apps/docs/.vitepress/cache/
apps/docs/.vitepress/dist/

# ─── Paperclip runtime / orchestration state ───────────────────────
# Paperclip creates a per-checkout worktree pool + control plane
# metadata. None of it is source.
.paperclip/
.paperclip/worktrees/

# ─── Mavis / local agent runtime scratchpads ────────────────────────
# Per-session Mavis artifacts (rooted in ~/.mavis, but never committable
# if they ever land in the working tree).
.mavis/

# ─── Lefthook / git hooks install cache ─────────────────────────────
.lefthook/
.hooky/
