{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window: core IPC (invoke + Channel), events, window and tray interaction.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:tray:default",
    "core:app:default",
    "core:menu:default"
  ]
}
